# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intervue_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Groq (free API key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Deepgram (free $200 credits from https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LiveKit (local dev server)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# TTS (Set provider to 'auto', 'elevenlabs', 'openai', or 'edge')
TTS_PROVIDER=auto
# If using ElevenLabs:
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# If using OpenAI:
OPENAI_API_KEY=your_openai_key
OPENAI_TTS_VOICE=ash

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRY_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Email
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password  # Generate at myaccount.google.com/apppasswords